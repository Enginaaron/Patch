PATCH_ENV=development
CAMERA_INDEX=0
GEMINI_API_KEY=
DATABASE_URL=sqlite:///./data/patch.db
MEDIA_ROOT=./data
AI_SAMPLE_INTERVAL_SECONDS=1.25

# OMNI (OpenAI-compatible multimodal gateway): search detection, voice, chat.
# Leave OMNI_API_KEY blank to run the fake/demo chat; searches need a real key.
OMNI_API_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_MODEL=qwen3.5-omni-plus
OMNI_CHAT_PATH=/chat/completions
OMNI_TIMEOUT_SECONDS=30

LOCAL_DETECTION_ENABLED=true
LOCAL_DETECTION_COOLDOWN_SECONDS=1.25

# ElevenLabs voice (speech out) — wired later.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Drive / motors. "sim" needs no hardware (logs intended wheel speeds).
# Set MOTOR_DRIVER=gpio on the Pi (pip install gpiozero lgpio) once wired.
MOTOR_DRIVER=sim
DRIVE_MAX_SPEED=1.0
# TB6612FNG pins (BCM numbering). See docs/HARDWARE.md for the wiring table.
MOTOR_STANDBY_PIN=16
MOTOR_LEFT_PWM_PIN=12
MOTOR_LEFT_IN1_PIN=5
MOTOR_LEFT_IN2_PIN=6
MOTOR_RIGHT_PWM_PIN=13
MOTOR_RIGHT_IN1_PIN=20
MOTOR_RIGHT_IN2_PIN=21
MOTOR_PWM_HZ=1000
# Flip a wheel's direction in software instead of rewiring:
MOTOR_LEFT_INVERT=false
MOTOR_RIGHT_INVERT=false
