PATCH_ENV=development
CAMERA_INDEX=0
GEMINI_API_KEY=
DATABASE_URL=sqlite:///./data/patch.db
MEDIA_ROOT=./data
AI_SAMPLE_INTERVAL_SECONDS=1.25

# Huawei OMNI Live. Leave OMNI_API_KEY blank to run the fake/demo chat.
# Fill it in (and adjust the URL/model/path if the gateway differs) to switch
# the same /api/chat endpoint to the real grounded multimodal model.
OMNI_API_KEY=
OMNI_BASE_URL=https://api.omni-live.huaweicloud.com/v1
OMNI_MODEL=omni-live
OMNI_CHAT_PATH=/chat/completions
OMNI_TIMEOUT_SECONDS=30

# ElevenLabs voice (speech out) — wired later.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Drive / motors. "sim" needs no hardware (logs intended wheel speeds).
# Set MOTOR_DRIVER=gpio on the Pi (pip install gpiozero lgpio) once wired.
MOTOR_DRIVER=sim
DRIVE_MAX_SPEED=1.0
# TB6612FNG pins (BCM numbering). See docs/HARDWARE.md for the wiring table.
MOTOR_STANDBY_PIN=25
MOTOR_LEFT_PWM_PIN=12
MOTOR_LEFT_IN1_PIN=17
MOTOR_LEFT_IN2_PIN=27
MOTOR_RIGHT_PWM_PIN=13
MOTOR_RIGHT_IN1_PIN=23
MOTOR_RIGHT_IN2_PIN=24
MOTOR_PWM_HZ=1000
# Flip a wheel's direction in software instead of rewiring:
MOTOR_LEFT_INVERT=false
MOTOR_RIGHT_INVERT=false

# Autonomous search tuning.
SEARCH_INTERVAL_SECONDS=0.6
SEARCH_SCAN_SPEED=0.5
SEARCH_TURN_SPEED=0.45
SEARCH_FORWARD_SPEED=0.55
SEARCH_CENTER_TOLERANCE=0.12
SEARCH_ARRIVAL_SIZE=0.45
SEARCH_MIN_CONFIDENCE=0.35
