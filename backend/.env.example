PATCH_ENV=development
CAMERA_INDEX=0
GEMINI_API_KEY=
DATABASE_URL=sqlite:///./data/patch.db
MEDIA_ROOT=./data
AI_SAMPLE_INTERVAL_SECONDS=1.25
# A camera frame older than this is treated as stale (no frame), so a dead
# capture stops feeding old pictures to the stream, the chat and the rover.
CAMERA_STALE_AFTER_SECONDS=2.0

# OMNI (OpenAI-compatible multimodal gateway): search detection, voice, chat.
# Leave OMNI_API_KEY blank to run the fake/demo chat; searches need a real key.
OMNI_API_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_MODEL=qwen3.5-omni-plus
OMNI_CHAT_PATH=/chat/completions
OMNI_TIMEOUT_SECONDS=30
# Bounds on every OMNI vision (search detection) call. The rover stands still
# while it waits, and additionally enforces ROVER_INFERENCE_TIMEOUT_SECONDS.
OMNI_VISION_TIMEOUT_SECONDS=20
OMNI_VISION_MAX_RETRIES=0
# Minimum OMNI likelihood (low | medium | high) before Patch asks "is this it?".
CANDIDATE_LIKELIHOOD_THRESHOLD=high

LOCAL_DETECTION_ENABLED=true
BLUR_VARIANCE_THRESHOLD=60
LOCAL_DETECTION_COOLDOWN_SECONDS=1.25

# ElevenLabs voice (speech out) — wired later.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Drive / motors. "sim" needs no hardware (logs intended wheel speeds).
# Set MOTOR_DRIVER=gpio on the Pi (pip install gpiozero lgpio) once wired.
MOTOR_DRIVER=sim
DRIVE_MAX_SPEED=1.0
# Deadman for manual /api/drive commands: the wheels stop by themselves this
# many seconds after the last command unless it is re-sent (the ControlPad
# re-sends while a button is held). 0 disables it.
DRIVE_MANUAL_TTL_SECONDS=2.0
# TB6612FNG pins (BCM numbering). See docs/HARDWARE.md for the wiring table.
MOTOR_STANDBY_PIN=16
MOTOR_LEFT_PWM_PIN=12
MOTOR_LEFT_IN1_PIN=5
MOTOR_LEFT_IN2_PIN=6
MOTOR_RIGHT_PWM_PIN=13
MOTOR_RIGHT_IN1_PIN=20
MOTOR_RIGHT_IN2_PIN=21
MOTOR_PWM_HZ=1000
# Flip a wheel's direction in software instead of rewiring:
MOTOR_LEFT_INVERT=false
MOTOR_RIGHT_INVERT=false
MOTOR_LEFT_SCALE=1.0
MOTOR_RIGHT_SCALE=1.0

# --- Rover autonomy (app/rover) -------------------------------------------------
# One controller owns the wheels during a search: it looks only while stopped
# and moves in short pulses, each bounded by an independent watchdog. Physical
# movement has NOT been verified yet -- every number below is a starting point
# to calibrate on the floor, not a measurement.
#
# ROVER_SIMULATION=true swaps in a synthetic camera and SIMULATED detections for
# the laptop demo. The server refuses to start with it unless MOTOR_DRIVER=sim:
# simulated detections must never move real motors.
ROVER_SIMULATION=false
# Scenario: two_bottles | single_bottle | empty
ROVER_SIM_SCENARIO=two_bottles

# Scanning: rotate in place in pulses, with stop + settle + fresh frame between.
ROVER_TURN_SPEED=0.4
# Approximate (no encoders): degrees per second of rotation AT ROVER_TURN_SPEED.
ROVER_TURN_DEGREES_PER_SECOND=85.0
ROVER_SCAN_PULSE_SECONDS=0.35
# Scan budget in pulses (~1 rotation + margin); then the search is "exhausted".
ROVER_SCAN_MAX_STEPS=14
# left | right
ROVER_SCAN_DIRECTION=right
# Wait after the wheels stop before trusting a camera frame.
ROVER_SETTLE_SECONDS=0.4
ROVER_FRAME_TIMEOUT_SECONDS=2.0
# Consecutive missing frames before giving up (phase error, wheels stopped).
ROVER_MAX_FRAME_FAILURES=3
# Ask OMNI every N scan steps even when YOLO sees nothing.
ROVER_OMNI_CHECK_EVERY_STEPS=3
# "Is this it?" questions per search before giving up.
ROVER_MAX_CANDIDATES=5
# Consecutive inference failures before giving up (phase error).
ROVER_MAX_VISION_ERRORS=3
ROVER_INFERENCE_TIMEOUT_SECONDS=20.0
# Horizontal field of view of the camera, degrees.
ROVER_CAMERA_HFOV_DEGREES=62.0
# A rejected object is not offered again within this bearing of where it stood.
ROVER_REJECT_BEARING_TOLERANCE_DEGREES=15.0

# Centring + approach: short pulses, a fresh look between each.
ROVER_TURN_PULSE_MIN_SECONDS=0.08
ROVER_TURN_PULSE_MAX_SECONDS=0.30
# |box centre - 0.5| below this counts as centred.
ROVER_CENTER_TOLERANCE=0.08
ROVER_FORWARD_SPEED=0.45
ROVER_FORWARD_PULSE_SECONDS=0.40
ROVER_SLOW_FORWARD_SPEED=0.35
ROVER_SLOW_FORWARD_PULSE_SECONDS=0.20
# Slow down once the box reaches this fraction of the arrival size.
ROVER_SLOW_ZONE_FRACTION=0.7
# Consecutive stationary observations needed to declare arrival.
ROVER_ARRIVAL_CONFIRMATIONS=2
# Minimum OMNI likelihood to keep approaching: low | medium | high
ROVER_APPROACH_MIN_LIKELIHOOD=medium
ROVER_APPROACH_MAX_SECONDS=90.0
ROVER_APPROACH_MAX_PULSES=40
# Pulses without visible progress before stopping.
ROVER_STALL_PULSES=3
ROVER_MIN_PROGRESS_FRACTION=0.03
# Stationary re-looks before declaring the target lost.
ROVER_REACQUIRE_ATTEMPTS=3
ROVER_OMNI_REVALIDATE_EVERY_PULSES=3
ROVER_ASSOCIATION_MAX_CENTER_SHIFT=0.30
ROVER_ASSOCIATION_MAX_SIZE_RATIO=2.0
# Each motor pulse arms the drive watchdog for (pulse length + this margin).
ROVER_PULSE_WATCHDOG_MARGIN_SECONDS=0.15
# Arrival is an apparent-size heuristic per category (no distance is measured).
# JSON overriding/extending the thresholds in app/rover/proximity.py, e.g.
#   ROVER_PROXIMITY_PROFILES_JSON={"bottle": {"arrive_width": 0.2}}
ROVER_PROXIMITY_PROFILES_JSON=
